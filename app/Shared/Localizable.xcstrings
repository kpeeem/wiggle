    "В GIF попадает одно качание длиной %@ с, ширина до 720 px. Он повторяется сам.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The GIF holds one %@ s swing, up to 720 px wide, and loops on its own."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GIFには%@秒の1往復が入ります。幅は最大720 pxで、自動でループします。"
          }
        }
      }
    },
